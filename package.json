    "vite": "^5.4.21"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
